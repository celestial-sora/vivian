GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
CEREBRAS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TYPESAFE_API_KEY=
# JEV_API_KEY is also accepted. Set false to keep deterministic legacy routing.
JEV_ENABLED=true
# Status/latency metadata only; development logs this automatically.
JEV_DEBUG=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Status display capacity for this project's file storage (Free default: 1 GB).
SUPABASE_STORAGE_LIMIT_BYTES=1000000000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Private Cloudflare R2 Standard bucket; never use NEXT_PUBLIC_ for R2 secrets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# New scenes use R2 after its credentials, bucket CORS and SQL migration are ready.
# Existing Supabase scenes remain readable. No fallback bypasses an R2 quota error.
SCENE_STORAGE_PROVIDER=r2
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=s2.1-pro-free
