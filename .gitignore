# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/supabase/.temp/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel
public/live2d/yuino-4096-backup/

# typescript
*.tsbuildinfo
next-env.d.ts

# Licensed Live2D model assets are local-only; retain the Cubism runtime.
/public/live2d/*
!/public/live2d/live2dcubismcore.min.js
*.moc3
*.cmo3

# Generated browser UnRAR runtime
/public/vendor/unrar.wasm
